# ocs-build.conf — settings for ocs-build.sh
#
# This file is sourced by bash. It must NOT be group/world-writable
# (chmod 600 ocs-build.conf); ocs-build.sh refuses to read it otherwise.
#
# NEVER put passwords or private keys in this file. Secrets are read from
# environment variables whose NAMES you list below.

###############################################################################
# 1. SIGNING CERTIFICATES (names)
###############################################################################
# Exact identity strings as printed by:
#     security find-identity -v
# (Developer ID Installer may not appear under "-p codesigning".)
# They look like:  Developer ID Application: <name> (<TEAMID>)
# Copy them verbatim; the script refuses placeholder values.
APP_SIGN_IDENTITY="REPLACE_ME Developer ID Application identity"
INSTALLER_SIGN_IDENTITY="REPLACE_ME Developer ID Installer identity"

# Your 10-character Apple Team ID (used only for a consistency check).
TEAM_ID="REPLACE_ME"

###############################################################################
# 2. SIGNING CERTIFICATES (locations) — choose ONE of A, B, or C
###############################################################################
# A) CI / clean build host: import from .p12 files into a temporary keychain
#    that is created for the build and deleted afterwards.
#    Each .p12 must contain the certificate AND its private key.
#    You may set one or both paths (set both for a full sign+package run).
APP_CERT_P12=""             # e.g. "$HOME/secure/DeveloperID_Application.p12"
INSTALLER_CERT_P12=""       # e.g. "$HOME/secure/DeveloperID_Installer.p12"
P12_PASSWORD_ENV="OCS_P12_PASSWORD"   # NAME of env var holding the .p12 password

# B) Certificates already live in a specific keychain file.
#    Leave empty to use the default keychain search list (option C).
SIGNING_KEYCHAIN=""         # e.g. "$HOME/Library/Keychains/signing.keychain-db"
SIGNING_KEYCHAIN_PASSWORD_ENV=""      # NAME of env var with its unlock password
                                      # (empty = don't unlock; must already be unlocked)

# C) Certificates are in your login keychain: leave A and B empty.

###############################################################################
# 3. NOTARIZATION CREDENTIALS — choose ONE of A or B
###############################################################################
# A) A profile stored once with:
#      xcrun notarytool store-credentials "ocs-notary" \
#          --apple-id "you@example.com" --team-id "<TEAMID>" --password "<app-specific-password>"
NOTARY_KEYCHAIN_PROFILE="ocs-notary"
NOTARY_KEYCHAIN=""          # optional: keychain file holding that profile

# B) App Store Connect API key (leave NOTARY_KEYCHAIN_PROFILE empty to use this).
NOTARY_API_KEY_PATH=""      # path to AuthKey_XXXXXXXXXX.p8
NOTARY_API_KEY_ID=""
NOTARY_API_ISSUER=""        # issuer UUID (omit for individual keys)

###############################################################################
# 4. SOURCE AND TOOLCHAIN
###############################################################################
OCS_REPO_URL="https://github.com/OCSInventory-NG/OCSInventory-Agent-Rework.git"
# Branch, tag, or full commit SHA. PIN THIS (a tag or SHA) for production
# builds; "main" moves.
OCS_REF="main"

# Note: after checkout, ocs-build.sh applies small local fixes to the source before
# building (currently: the LaunchDaemon plist's "--service true" -> "--service=true",
# upstream issue #175). Nothing to configure here; see apply_source_fixes in the script.

# "download" = fetch an official Dart SDK zip (checksum-verified) into WORK_DIR.
# "system"   = use whatever `dart` is on PATH (host architecture only).
DART_SOURCE="download"
DART_CHANNEL="stable"
DART_VERSION="latest"       # or pin, e.g. "3.x.y"
DART_MIRROR_BASE="https://storage.googleapis.com/dart-archive"

###############################################################################
# 5. PACKAGE
###############################################################################
# Architectures to build, one .pkg each. Allowed: arm64 x86_64
# Building x86_64 on an Apple silicon host runs the x64 Dart SDK under
# Rosetta 2 (must be installed). Building arm64 on an Intel host is not supported.
TARGET_ARCHS="arm64"

BINARY_NAME="ocsinventory-cli"                 # installed to /usr/local/bin/
BINARY_CODESIGN_ID="com.ocsinventory.agent.cli"  # code signing identifier
PKG_IDENTIFIER="com.ocsinventory.agent"        # package receipt identifier
PKG_TITLE="OCS Inventory Agent"
PKG_VERSION="auto"          # "auto" = version from pubspec.yaml, else build date

# Optional entitlements plist for the main binary. Leave empty (recommended)
# unless testing proves the hardened runtime blocks something specific.
ENTITLEMENTS_FILE="dart_entitlements.plist"

###############################################################################
# 5b. SETUP VALUES BAKED INTO THE PACKAGE
###############################################################################
# install.sh is shipped exactly as upstream wrote it; the build never edits it.
# Instead, these values are baked into the generated postinstall script as
# command-line arguments, and the postinstall runs:
#     install.sh -S -U <URL> -u <USERNAME> -p <PASSWORD> [-s if SERVICE] [-n if NOW]
#
# RE-INSTALLS: if an agent is already present, install.sh itself runs
# "uninstall.sh -S -D" first (hard delete: removes the config directory, data
# directory, log file, binary and LaunchDaemon) and then installs again with these
# values. The package's postinstall never uninstalls anything. uninstall.sh needs
# `realpath` (built into recent macOS; check your minimum supported version).
#
# SECURITY: the values end up in clear text inside the .pkg (in the postinstall
# script; install.sh itself holds no credentials), and the .pkg is UPLOADED TO
# APPLE for notarization. Anyone who can obtain the .pkg (e.g. from the Jamf
# distribution point) can read them. While install.sh runs on the target Mac, the
# password is briefly visible in the process list as an argument. Use a dedicated,
# low-privilege OCS account. Changing any value means rebuilding, re-signing and
# re-notarizing the package.

# true  = the postinstall runs install.sh non-interactively with the values below
#         passed as arguments (URL, USERNAME and PASSWORD are then required).
# false = the package only installs the files; nothing is configured.
SILENT="true"

URL=""            # e.g. https://ocs.example.com:443  (must start with http:// or https://)
USERNAME=""
# Prefer leaving this as a placeholder and exporting OCS_PASSWORD for the build
# (the environment variable wins over this value), so the password is not stored here.
PASSWORD=""
# URL, USERNAME and PASSWORD must not contain a double quote, a backslash or a
# line break: the upstream install.sh writes them into config.json without escaping.

# Optional extras (not part of the four values above). In silent mode install.sh's
# own defaults are SERVICE=false and NOW=false, i.e. NO LaunchDaemon is registered
# and nothing runs - the agent would be installed and configured but never scheduled.
SERVICE="true"             # true = pass -s: register the LaunchDaemon (needs the plist beside install.sh)
NOW="true"                 # true = pass -n: run one inventory right after install. install.sh then passes the
                            # values UNQUOTED to a command, so URL/USERNAME/PASSWORD must not contain
                            # whitespace or any of * ? [ $ ` (the build checks), and it writes that
                            # command line - password included - to install.log (the postinstall makes
                            # the setup logs root-only).

###############################################################################
# 6. DIRECTORIES
###############################################################################
WORK_DIR="$HOME/ocs-build-work"     # downloads, SDKs, source, staging
OUTPUT_DIR="$HOME/ocs-build-out"    # final .pkg + manifest
